APP_NAME="Link Space Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Slack error alerts. In production set LOG_STACK=single,slack (or daily,slack)
# and the webhook URL; leave slack out of LOG_STACK while the URL is empty.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=bahgatayman10@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="bahgatayman10@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Super Admin created by AdminSeeder (password required when APP_ENV=production)
ADMIN_SEED_EMAIL=bahgatayman@gmail.com
ADMIN_SEED_PASSWORD=

# Google Maps browser key for the Create Workspace location picker (restrict by HTTP referrer).
# Needs: Maps JavaScript API, Places API (New); Geocoding API for "Use my current location".
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Customer API (/api/v1) — see docs/API.md
# Browser origins allowed to call the API (comma-separated, exact scheme+host, no trailing slash).
# Empty = no cross-origin browser access. Never use "*".
CORS_ALLOWED_ORIGINS=
# Public API requests per minute per client IP.
API_PUBLIC_RATE_LIMIT=60
# Reverse proxies/CDN whose X-Forwarded-* headers are trusted (IPs/CIDRs, comma-separated, or "*").
# Leave empty if PHP sees HTTPS directly (typical shared hosting).
TRUSTED_PROXIES=
